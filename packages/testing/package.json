{
  "name": "@kafka-playground/testing",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "echo \"No build configured\"",
    "lint": "echo \"No lint configured\"",
    "test": "echo \"No tests configured\"",
    "test:e2e:gate": "pnpm --filter @kafka-playground/outbox build && node scripts/production-gate.e2e.mjs && node scripts/order-consumer-idempotency.e2e.mjs && pnpm test:e2e:outbox-concurrent-publish && pnpm test:e2e:admin-audit-security",
    "test:e2e:order-pipeline": "node scripts/order-pipeline.e2e.mjs",
    "test:e2e:outbox": "node scripts/outbox-publish.e2e.mjs",
    "test:e2e:outbox-failure": "node scripts/outbox-kafka-failure.e2e.mjs",
    "test:e2e:outbox-concurrent-publish": "pnpm --filter @kafka-playground/outbox build && node scripts/outbox-concurrent-publish.e2e.mjs",
    "test:e2e:schema-registry-outage": "node scripts/schema-registry-outage.e2e.mjs",
    "test:e2e:postgres-restart": "node scripts/postgres-restart.e2e.mjs",
    "test:e2e:idempotency": "node scripts/order-consumer-idempotency.e2e.mjs",
    "test:e2e:order-lifecycle": "node scripts/order-lifecycle.e2e.mjs",
    "test:e2e:dlq-management": "node scripts/dlq-management.e2e.mjs",
    "test:e2e:admin-audit-security": "node scripts/admin-audit-security.e2e.mjs",
    "test:e2e:consumer-inbox": "node scripts/consumer-inbox-restart.e2e.mjs",
    "test:e2e:consumer-inbox-crash-window": "node scripts/consumer-inbox-crash-window.e2e.mjs",
    "test:e2e:consumer-inbox-rebalance": "node scripts/consumer-inbox-rebalance-contention.e2e.mjs",
    "test:e2e:chaos": "pnpm test:e2e:outbox-failure && pnpm test:e2e:outbox-concurrent-publish && pnpm test:e2e:schema-registry-outage && pnpm test:e2e:postgres-restart && pnpm test:e2e:idempotency && pnpm test:e2e:consumer-inbox-crash-window && pnpm test:e2e:consumer-inbox-rebalance",
    "test:load:order-pipeline": "node scripts/run-k6-load.mjs load",
    "test:load:baseline": "node scripts/load-baseline.mjs capture",
    "test:load:compare": "node scripts/load-baseline.mjs compare",
    "test:load:smoke": "node scripts/run-k6-load.mjs smoke",
    "test:load:stress": "node scripts/run-k6-load.mjs stress"
  },
  "dependencies": {
    "@kafkajs/confluent-schema-registry": "^4.1.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.21.0"
  }
}
