{
  "name": "@kafka-playground/outbox",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm --filter @kafka-playground/kafka build && pnpm --filter @kafka-playground/observability build",
    "build": "tsc -p tsconfig.json",
    "prelint": "pnpm --filter @kafka-playground/kafka build && pnpm --filter @kafka-playground/observability build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@kafka-playground/kafka": "workspace:^",
    "@kafka-playground/observability": "workspace:^",
    "@nestjs/common": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "typeorm": "^0.3.24"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
